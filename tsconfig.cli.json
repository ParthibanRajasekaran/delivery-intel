{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": [
    "src/cli/**/*.ts",
    "src/aidt/**/*.ts",
    "src/shared/**/*.ts",
    "src/collectors/**/*.ts",
    "src/domain/**/*.ts",
    "src/metrics/**/*.ts",
    "src/normalize/**/*.ts",
    "src/scoring/**/*.ts",
    "src/security/**/*.ts"
  ],
  "exclude": ["src/**/__tests__/**/*.ts", "src/**/*.test.ts", "src/**/*.spec.ts"]
}
